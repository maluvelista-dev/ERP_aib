<% if (pagination && pagination.totalPages > 1) { %>
  <nav class="mt-3" aria-label="Paginação">
    <ul class="pagination pagination-sm justify-content-center mb-0">
      <% const makePageUrl = (page) => `?${new URLSearchParams({ ...(paginationQuery || {}), page: String(page) }).toString()}`; %>
      <li class="page-item <%= pagination.page <= 1 ? 'disabled' : '' %>">
        <a class="page-link" href="<%= makePageUrl(Math.max(1, pagination.page - 1)) %>">Anterior</a>
      </li>
      <li class="page-item disabled"><span class="page-link">Página <%= pagination.page %> de <%= pagination.totalPages %></span></li>
      <li class="page-item <%= pagination.page >= pagination.totalPages ? 'disabled' : '' %>">
        <a class="page-link" href="<%= makePageUrl(Math.min(pagination.totalPages, pagination.page + 1)) %>">Próxima</a>
      </li>
    </ul>
  </nav>
<% } %>
