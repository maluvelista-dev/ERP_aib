<%- include('../partials/head') %>
<div class="app-shell d-flex">
  <%- include('../partials/sidebar') %>
  <div class="flex-grow-1">
    <%- include('../partials/topbar') %>
    <main class="p-4">
      <%- include('../partials/flash') %>
      <section class="content-panel p-3">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-3">
          <div class="d-flex flex-column align-items-start gap-2">
            <div>
              <h2 class="h6 mb-1">Pedidos</h2>
              <div class="small text-muted"><%= pagination.total %> pedido(s) encontrado(s)</div>
            </div>
            <a class="btn btn-sm btn-primary" href="/orders/new">Novo pedido</a>
            <div class="d-flex gap-2 flex-wrap align-items-center">
              <a
                class="btn btn-sm btn-outline-primary js-resume-order-draft <%= draft ? '' : 'd-none' %>"
                href="/orders/new?resumeDraft=1"
                data-draft-key="ordersweb.orderDraft.<%= currentUser.id %>"
              >Retomar rascunho</a>
              <% if (draft) { %>
                <form action="/orders/drafts/delete" method="post" class="m-0 js-discard-order-draft" data-draft-key="ordersweb.orderDraft.<%= currentUser.id %>">
                  <button class="btn btn-sm btn-outline-secondary" type="submit">Descartar rascunho</button>
                </form>
              <% } %>
            </div>
            <% if (orders.length > 0 && currentUser.role === 'seller') { %>
              <form
                action="/orders/clear-history"
                method="post"
                class="js-clear-order-history-form"
                data-history-scope="<%= canFilterByCollaborator ? (selectedCollaboratorId ? 'do colaborador selecionado' : 'de todos os colaboradores') : 'dos seus pedidos' %>"
              >
                <% if (canFilterByCollaborator && selectedCollaboratorId) { %>
                  <input type="hidden" name="createdById" value="<%= selectedCollaboratorId %>">
                <% } %>
                <button class="btn btn-sm btn-outline-danger" type="submit"><%= currentUser.role === 'admin' ? 'Limpar histórico' : 'Limpar meus pedidos' %></button>
              </form>
            <% } %>
          </div>

          <% if (canFilterByCollaborator) { %>
            <form action="/orders" method="get" class="product-filter d-flex gap-2 align-items-end">
              <div>
                <label class="form-label" for="createdById">Colaborador</label>
                <select class="form-select form-select-sm" id="createdById" name="createdById">
                  <option value="">Todos</option>
                  <% collaborators.forEach((collaborator) => { %>
                    <option value="<%= collaborator.id %>" <%= selectedCollaboratorId === collaborator.id ? 'selected' : '' %>>
                      <%= collaborator.name %> - <%= collaborator.role %>
                    </option>
                  <% }) %>
                </select>
              </div>
              <div>
                <label class="form-label" for="period">Per&iacute;odo</label>
                <select class="form-select form-select-sm" id="period" name="period">
                  <option value="">Todos</option>
                  <option value="week" <%= selectedPeriod === 'week' ? 'selected' : '' %>>Esta semana</option>
                  <option value="15days" <%= selectedPeriod === '15days' ? 'selected' : '' %>>&Uacute;ltimos 15 dias</option>
                  <option value="30days" <%= selectedPeriod === '30days' ? 'selected' : '' %>>&Uacute;ltimos 30 dias</option>
                </select>
              </div>
              <button class="btn btn-sm btn-primary" type="submit">Aplicar filtro</button>
              <% if (selectedCollaboratorId || selectedPeriod) { %>
                <a class="btn btn-sm btn-outline-secondary" href="/orders">Limpar</a>
              <% } %>
            </form>
          <% } %>
        </div>
        <% if (selectedCustomer) { %>
          <div class="alert alert-info d-flex justify-content-between align-items-center gap-2">
            <span>Pedidos de <strong><%= selectedCustomer.legalName || selectedCustomer.tradeName || selectedCustomer.cnpj || 'Cliente sem nome' %></strong></span>
            <a class="btn btn-sm btn-outline-secondary" href="/orders">Ver todos</a>
          </div>
        <% } %>
        <%- include('_table', { orders }) %>
        <%- include('../partials/pagination', { pagination, paginationQuery }) %>
      </section>
    </main>
  </div>
</div>
<%- include('../partials/foot') %>
