<div class="table-responsive">
  <% const receivedTimeLabels = { BUSINESS_HOURS: 'Hor&aacute;rio comercial', MORNING: 'Manh&atilde;', AFTERNOON: 'Tarde' }; %>
  <table class="table table-sm table-hover mb-0 orders-table">
    <thead>
      <tr>
        <th>N&uacute;mero</th>
        <th>Cliente</th>
        <th>Colaborador</th>
        <th>Recebimento</th>
        <th class="text-end orders-total-column d-none d-md-table-cell">Total</th>
        <th class="orders-status-column">Status</th>
        <th>PDF</th>
        <th class="text-end">A&ccedil;&otilde;es</th>
      </tr>
    </thead>
    <tbody>
      <% orders.forEach((order) => { %>
        <%
          const tableSubtotal = (order.items || []).reduce(
            (sum, item) => sum + Number(item.totalPrice || 0),
            0
          );
          const tableDiscount = Number(order.discountAmount || 0);
          const tableTotal = Math.max(tableSubtotal - tableDiscount, 0);
        %>
        <tr>
          <td>
            <a class="fw-semibold text-decoration-none" href="/orders/<%= order.id %>">
              <%= order.orderNumber %>
            </a>
          </td>
          <td>
            <div><%= order.customerSnapshot.legalName || order.customerSnapshot.tradeName || 'Cliente sem nome' %></div>
            <div class="d-md-none mt-1 fw-semibold">
              Total: R$ <%= tableTotal.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
            </div>
          </td>
          <td><%= order.createdBy?.name || 'N&atilde;o informado' %></td>
          <td><%- receivedTimeLabels[order.receivedTime] || order.receivedTime || '-' %></td>
          <td class="text-end orders-total-column d-none d-md-table-cell">R$ <%= tableTotal.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></td>
          <td class="orders-status-column"><span class="badge text-bg-secondary"><%= order.status %></span></td>
          <td>
            <% if (order.pdfUrl) { %>
              <a href="<%= order.pdfUrl %>">Abrir PDF</a>
            <% } else { %>
              <span class="text-muted">N&atilde;o gerado</span>
            <% } %>
          </td>
          <td class="text-end">
            <div class="d-inline-flex flex-wrap justify-content-end gap-1">
              <% if (currentUser.role === 'admin' || order.createdById === currentUser.id) { %>
                <form action="/orders/<%= order.id %>/pdf" method="post" class="d-inline js-generate-pdf-form">
                  <% if (order.pdfUrl) { %><input type="hidden" name="force" value="1"><% } %>
                  <button class="btn btn-sm btn-outline-primary" type="submit">Gerar PDF</button>
                </form>
              <% } %>
              <% if (order.createdById === currentUser.id) { %>
                <a class="btn btn-sm btn-outline-secondary" href="/orders/<%= order.id %>/edit">Editar</a>
                <form action="/orders/<%= order.id %>/delete" method="post" class="d-inline js-delete-order-form" data-order-number="<%= order.orderNumber %>">
                  <button class="btn btn-sm btn-outline-danger" type="submit">Excluir</button>
                </form>
              <% } %>
            </div>
          </td>
        </tr>
      <% }) %>
      <% if (!orders.length) { %>
        <tr>
          <td colspan="8" class="text-center text-muted py-4">Nenhum pedido encontrado.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
