<div class="manual-order-item-row border border-secondary rounded p-3 mb-3">
  <div class="d-flex justify-content-between align-items-center mb-2">
    <span class="badge text-bg-secondary">Produto manual</span>
    <button class="btn btn-sm btn-outline-danger js-remove-manual-order-item" type="button">Remover</button>
  </div>
  <div class="row g-2 align-items-end">
    <div class="col-lg-6">
      <label class="form-label">Nome do produto</label>
      <input class="form-control" name="manualProductName" maxlength="191" required placeholder="Digite o nome ou a descrição do produto">
    </div>
    <div class="col-md-3 col-lg-2">
      <label class="form-label">Quantidade</label>
      <input class="form-control" name="manualQuantity" type="number" min="1" value="1" required>
    </div>
    <div class="col-md-5 col-lg-3">
      <label class="form-label">Preço unitário</label>
      <div class="input-group">
        <span class="input-group-text">R$</span>
        <input class="form-control" name="manualPrice" type="number" min="0" step="0.01" required placeholder="0,00">
      </div>
    </div>
  </div>
</div>
