<option value="">Selecione o produto</option>
<% products.forEach((product) => { %>
  <option value="<%= product.id %>">
    <%= product.code %> - <%= product.name %> - <%= product.productCategory?.name || product.category %> - Un. R$ <%= Number(product.unitPrice ?? 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
    <% if (product.boxPrice) { %>
      | Cx. R$ <%= Number(product.boxPrice).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
    <% } %>
  </option>
<% }) %>
<% if (!products.length) { %>
  <option value="">Nenhum produto encontrado</option>
<% } %>
