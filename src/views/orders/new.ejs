<%- include('../partials/head') %>
<%
  const editing = Boolean(order);
  const selectedDeliveryDays = new Set(order?.deliveryDays || []);
  const catalogItems = order?.items?.filter((item) => item.productId) || [];
  const manualItems = order?.items?.filter((item) => !item.productId) || [];
%>
<div class="app-shell d-flex">
  <%- include('../partials/sidebar') %>
  <div class="flex-grow-1">
    <%- include('../partials/topbar') %>
    <main class="p-4">
      <%- include('../partials/flash') %>
      <section class="content-panel p-3">
        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <% if (!customers.length) { %>
          <div class="alert alert-warning">
            Cadastre ao menos um cliente ativo antes de criar pedidos.
          </div>
        <% } %>
        <form action="<%= editing ? `/orders/${order.id}` : '/orders' %>" method="post" class="d-grid gap-4">
          <div>
            <label class="form-label">Cliente</label>
            <select class="form-select" name="customerId" required>
              <option value="">Selecione o cliente</option>
              <% customers.forEach((customer) => { %>
                <option value="<%= customer.id %>" <%= String(order?.customerId || '') === String(customer.id) ? 'selected' : '' %>><%= customer.legalName || customer.tradeName || 'Cliente sem nome' %><%= customer.cnpj ? ` - ${customer.cnpj}` : '' %></option>
              <% }) %>
            </select>
          </div>

          <div class="row g-3">
            <div class="col-md-6 col-lg-4">
              <label class="form-label" for="sellerPhone">Telefone do vendedor</label>
              <input class="form-control" id="sellerPhone" name="sellerPhone" value="<%= order?.sellerPhone || '' %>" placeholder="(11) 99999-9999">
            </div>
            <div class="col-md-6 col-lg-4">
              <label class="form-label" for="bonusProductId">Bonifica&ccedil;&atilde;o</label>
              <select class="form-select" id="bonusProductId" name="bonusProductId">
                <option value="">Sem bonifica&ccedil;&atilde;o</option>
                <% products.forEach((product) => { %>
                  <option value="<%= product.id %>" <%= String(order?.bonusProductId || '') === String(product.id) ? 'selected' : '' %>><%= product.code %> - <%= product.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6 col-lg-4">
              <label class="form-label" for="discountPercent">Desconto personalizado</label>
              <div class="input-group">
                <input class="form-control" id="discountPercent" name="discountPercent" type="number" min="0" max="100" step="0.01" value="<%= order ? Number(order.discountPercent || 0) : 0 %>">
                <span class="input-group-text">%</span>
              </div>
            </div>
          </div>

          <fieldset>
            <legend class="form-label mb-2">Dias dispon&iacute;veis para entrega</legend>
            <div class="d-flex flex-wrap gap-3">
              <% [
                ['MON', 'S', 'Segunda-feira'],
                ['TUE', 'T', 'Ter&ccedil;a-feira'],
                ['WED', 'Q', 'Quarta-feira'],
                ['THU', 'Q', 'Quinta-feira'],
                ['FRI', 'S', 'Sexta-feira'],
                ['SAT', 'S', 'S&aacute;bado'],
                ['SUN', 'D', 'Domingo']
              ].forEach(([value, initial, label]) => { %>
                <div class="form-check" title="<%- label %>">
                  <input class="form-check-input" type="checkbox" name="deliveryDays" value="<%= value %>" id="deliveryDay<%= value %>" <%= selectedDeliveryDays.has(value) ? 'checked' : '' %>>
                  <label class="form-check-label" for="deliveryDay<%= value %>">
                    <strong><%= initial %></strong> <span class="small text-muted"><%- label %></span>
                  </label>
                </div>
              <% }) %>
            </div>
          </fieldset>

          <fieldset>
            <legend class="form-label mb-2">Hor&aacute;rio de recebimento</legend>
            <div class="d-flex flex-wrap gap-3">
              <% [
                ['BUSINESS_HOURS', 'Hor&aacute;rio comercial'],
                ['MORNING', 'Hor&aacute;rio da manh&atilde;'],
                ['AFTERNOON', 'Hor&aacute;rio da tarde']
              ].forEach(([value, label]) => { %>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="receivedTime" value="<%= value %>" id="receivedTime<%= value %>" <%= order?.receivedTime === value ? 'checked' : '' %>>
                  <label class="form-check-label" for="receivedTime<%= value %>"><%- label %></label>
                </div>
              <% }) %>
            </div>
          </fieldset>

          <div class="row g-3">
            <div class="col-lg-4">
              <label class="form-label" for="fiscalEmail">E-mail para documentos fiscais</label>
              <input class="form-control" id="fiscalEmail" name="fiscalEmail" type="email" maxlength="191" value="<%= order?.fiscalEmail || '' %>" placeholder="fiscal@empresa.com.br">
              <div class="form-text">Destinado ao envio futuro da NF-e e do DANFE.</div>
            </div>
            <div class="col-lg-4">
              <label class="form-label" for="contactEmail">E-mail de contato</label>
              <input class="form-control" id="contactEmail" name="contactEmail" type="email" maxlength="191" value="<%= order?.contactEmail || '' %>" placeholder="comprador@empresa.com.br">
              <div class="form-text">E-mail do comprador respons&aacute;vel ou contato geral da empresa.</div>
            </div>
            <div class="col-lg-4">
              <label class="form-label" for="paymentTerm">Prazo de pagamento</label>
              <input class="form-control" id="paymentTerm" name="paymentTerm" maxlength="191" value="<%= order?.paymentTerm || '' %>" placeholder="Ex.: 28 dias ou 28/35/42 dias">
            </div>
          </div>

          <div>
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h2 class="h6 mb-0">Itens</h2>
              <button
                class="btn btn-sm btn-outline-secondary"
                type="button"
                hx-get="/orders/manual-item-row"
                hx-target="#manual-order-items"
                hx-swap="beforeend"
              >Adicionar produto manualmente</button>
            </div>
            <div id="order-items">
              <% if (catalogItems.length) { %>
                <% catalogItems.forEach((currentItem) => { %>
                  <%- include('_item_row', { products, currentItem }) %>
                <% }) %>
              <% } else { %>
                <%- include('_item_row', { products, currentItem: null }) %>
              <% } %>
            </div>
            <div id="manual-order-items">
              <% manualItems.forEach((currentItem) => { %>
                <%- include('_manual_item_row', { currentItem }) %>
              <% }) %>
            </div>
          </div>

          <div>
            <label class="form-label" for="notes">Observa&ccedil;&atilde;o</label>
            <textarea class="form-control" id="notes" name="notes" rows="3" maxlength="1000" placeholder="Informa&ccedil;&otilde;es adicionais para o pedido e para a nota"><%= order?.notes || '' %></textarea>
          </div>

          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="sendWhatsapp" name="sendWhatsapp">
            <label class="form-check-label" for="sendWhatsapp">Gerar e enviar pelo WhatsApp</label>
          </div>

          <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit" <%= !customers.length ? 'disabled' : '' %>><%- editing ? 'Salvar altera&ccedil;&otilde;es' : 'Criar pedido' %></button>
            <a class="btn btn-outline-secondary" href="/orders">Cancelar</a>
          </div>
        </form>
      </section>
    </main>
  </div>
</div>
<%- include('../partials/foot') %>
