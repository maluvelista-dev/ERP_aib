<%- include('../partials/head') %>
<div class="app-shell d-flex">
  <%- include('../partials/sidebar') %>
  <div class="flex-grow-1">
    <%- include('../partials/topbar') %>
    <main class="p-4">
      <%- include('../partials/flash') %>
      <section class="content-panel p-3">
        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <% if (!customers.length || !products.length) { %>
          <div class="alert alert-warning">
            Cadastre ao menos um cliente ativo e um produto ativo antes de criar pedidos.
          </div>
        <% } %>
        <form action="/orders" method="post" class="d-grid gap-4">
          <div>
            <label class="form-label">Cliente</label>
            <select class="form-select" name="customerId" required>
              <option value="">Selecione o cliente</option>
              <% customers.forEach((customer) => { %>
                <option value="<%= customer.id %>"><%= customer.legalName || customer.tradeName || 'Cliente sem nome' %><%= customer.cnpj ? ` - ${customer.cnpj}` : '' %></option>
              <% }) %>
            </select>
          </div>

          <div class="row g-3">
            <div class="col-md-6 col-lg-3">
              <label class="form-label" for="sellerPhone">Telefone do vendedor</label>
              <input class="form-control" id="sellerPhone" name="sellerPhone" placeholder="(11) 99999-9999">
            </div>
            <div class="col-md-6 col-lg-3">
              <label class="form-label" for="receivedTime">Hor&aacute;rio de recebimento</label>
              <input class="form-control" id="receivedTime" name="receivedTime" type="time">
            </div>
            <div class="col-md-6 col-lg-3">
              <label class="form-label" for="bonusProductId">Bonifica&ccedil;&atilde;o</label>
              <select class="form-select" id="bonusProductId" name="bonusProductId">
                <option value="">Sem bonifica&ccedil;&atilde;o</option>
                <% products.forEach((product) => { %>
                  <option value="<%= product.id %>"><%= product.code %> - <%= product.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6 col-lg-3 d-flex align-items-end">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="applyDiscount" name="applyDiscount">
                <label class="form-check-label" for="applyDiscount">Aplicar 5% de desconto</label>
              </div>
            </div>
          </div>

          <fieldset>
            <legend class="form-label mb-2">Dias dispon&iacute;veis para entrega</legend>
            <div class="d-flex flex-wrap gap-3">
              <% [
                ['MON', 'S', 'Segunda-feira'],
                ['TUE', 'T', 'Ter&ccedil;a-feira'],
                ['WED', 'Q', 'Quarta-feira'],
                ['THU', 'Q', 'Quinta-feira'],
                ['FRI', 'S', 'Sexta-feira'],
                ['SAT', 'S', 'S&aacute;bado'],
                ['SUN', 'D', 'Domingo']
              ].forEach(([value, initial, label]) => { %>
                <div class="form-check" title="<%- label %>">
                  <input class="form-check-input" type="checkbox" name="deliveryDays" value="<%= value %>" id="deliveryDay<%= value %>">
                  <label class="form-check-label" for="deliveryDay<%= value %>">
                    <strong><%= initial %></strong> <span class="small text-muted"><%- label %></span>
                  </label>
                </div>
              <% }) %>
            </div>
          </fieldset>

          <div class="row g-3">
            <div class="col-lg-4">
              <label class="form-label" for="fiscalEmail">E-mail para documentos fiscais</label>
              <input class="form-control" id="fiscalEmail" name="fiscalEmail" type="email" maxlength="191" placeholder="fiscal@empresa.com.br">
              <div class="form-text">Destinado ao envio futuro da NF-e e do DANFE.</div>
            </div>
            <div class="col-lg-4">
              <label class="form-label" for="contactEmail">E-mail de contato</label>
              <input class="form-control" id="contactEmail" name="contactEmail" type="email" maxlength="191" placeholder="comprador@empresa.com.br">
              <div class="form-text">E-mail do comprador respons&aacute;vel ou contato geral da empresa.</div>
            </div>
            <div class="col-lg-4">
              <label class="form-label" for="paymentTerm">Prazo de pagamento</label>
              <input class="form-control" id="paymentTerm" name="paymentTerm" maxlength="191" placeholder="Ex.: 28 dias ou 28/35/42 dias">
            </div>
          </div>

          <div>
            <label class="form-label" for="notes">Observa&ccedil;&atilde;o</label>
            <textarea class="form-control" id="notes" name="notes" rows="3" maxlength="1000" placeholder="Informa&ccedil;&otilde;es adicionais para o pedido e para a nota"></textarea>
          </div>

          <div>
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h2 class="h6 mb-0">Itens</h2>
            </div>
            <div id="order-items">
              <%- include('_item_row', { products }) %>
            </div>
          </div>

          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="sendWhatsapp" name="sendWhatsapp">
            <label class="form-check-label" for="sendWhatsapp">Gerar e enviar pelo WhatsApp</label>
          </div>

          <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit" <%= (!customers.length || !products.length) ? 'disabled' : '' %>>Criar pedido</button>
            <a class="btn btn-outline-secondary" href="/orders">Cancelar</a>
          </div>
        </form>
      </section>
    </main>
  </div>
</div>
<%- include('../partials/foot') %>
