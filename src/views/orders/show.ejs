<%- include('../partials/head') %>
<div class="app-shell d-flex">
  <%- include('../partials/sidebar') %>
  <div class="flex-grow-1">
    <%- include('../partials/topbar') %>
    <main class="p-4">
      <%- include('../partials/flash') %>

      <section class="content-panel p-3 mb-3">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
          <div>
            <h2 class="h6 mb-1">Pedido <%= order.orderNumber %></h2>
            <div class="small text-muted">
              Criado por <%= order.createdBy?.name || 'Não informado' %> em
              <%= new Date(order.createdAt).toLocaleString('pt-BR') %>
            </div>
          </div>
          <div class="d-flex gap-2 align-items-start">
            <% if (order.pdfUrl) { %>
              <a class="btn btn-sm btn-outline-primary" href="<%= order.pdfUrl %>" target="_blank">Abrir PDF</a>
            <% } %>
            <form action="/orders/<%= order.id %>/pdf" method="post" class="m-0" target="_blank">
              <button class="btn btn-sm btn-primary" type="submit">Gerar PDF</button>
            </form>
            <% if (order.createdById === currentUser.id && order.customerSnapshot.whatsapp) { %>
              <form action="/orders/<%= order.id %>/whatsapp" method="post" class="m-0">
                <button class="btn btn-sm btn-success" type="submit">Abrir WhatsApp</button>
              </form>
            <% } %>
            <a class="btn btn-sm btn-outline-secondary" href="/orders">Voltar</a>
          </div>
        </div>
      </section>

      <section class="row g-3 mb-3">
        <div class="col-lg-6">
          <div class="content-panel p-3 h-100">
            <h3 class="h6 mb-3">Cliente</h3>
            <div class="fw-semibold"><%= order.customerSnapshot.legalName || order.customerSnapshot.tradeName || 'Cliente sem nome' %></div>
            <% if (order.customerSnapshot.tradeName) { %>
              <div class="small text-muted"><%= order.customerSnapshot.tradeName %></div>
            <% } %>
            <div class="mt-2 small">CNPJ: <%= order.customerSnapshot.cnpj || 'Não informado' %></div>
            <div class="small">WhatsApp: <%= order.customerSnapshot.whatsapp || 'Não informado' %></div>
            <div class="small">
              <%= [order.customerSnapshot.street, order.customerSnapshot.number, order.customerSnapshot.district, order.customerSnapshot.city, order.customerSnapshot.state].filter(Boolean).join(', ') || 'Endereço não informado' %>
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="content-panel p-3 h-100">
            <h3 class="h6 mb-3">Resumo</h3>
            <div class="mb-2">
              <span class="badge text-bg-secondary"><%= order.status %></span>
            </div>
            <div class="small">Vendedor: <%= order.sellerSnapshot?.name || order.createdBy?.name || 'Não informado' %></div>
            <div class="small">Telefone vendedor: <%= order.sellerSnapshot?.phone || 'Não informado' %></div>
            <% const receivedTimeLabels = { BUSINESS_HOURS: 'Horário comercial', MORNING: 'Horário da manhã', AFTERNOON: 'Horário da tarde' }; %>
            <div class="small">Horário de recebimento: <%= receivedTimeLabels[order.receivedTime] || order.receivedTime || 'Não informado' %></div>
            <% const deliveryDayLabels = { MON: 'Segunda', TUE: 'Terça', WED: 'Quarta', THU: 'Quinta', FRI: 'Sexta', SAT: 'Sábado', SUN: 'Domingo' }; %>
            <div class="small">
              Dias para entrega:
              <%= Array.isArray(order.deliveryDays) && order.deliveryDays.length
                ? order.deliveryDays.map((day) => deliveryDayLabels[day] || day).join(', ')
                : 'Não informado' %>
            </div>
            <% if (order.notes) { %>
              <div class="small mt-2"><strong>Observa&ccedil;&atilde;o:</strong> <%= order.notes %></div>
            <% } %>
            <div class="small mt-2">E-mail fiscal: <%= order.fiscalEmail || 'Não informado' %></div>
            <div class="small">E-mail de contato: <%= order.contactEmail || 'Não informado' %></div>
            <div class="small">Prazo de pagamento: <%= order.paymentTerm || 'Não informado' %></div>
            <div class="small">PDF: <%= order.pdfUrl ? 'Gerado' : 'Não gerado' %></div>
            <div class="small">WhatsApp: o envio é confirmado manualmente no aplicativo</div>
            <% if (order.bonusProductSnapshot) { %>
              <div class="small mt-2">Bonifica&ccedil;&atilde;o: <%= order.bonusProductSnapshot.code %> - <%= order.bonusProductSnapshot.name %></div>
            <% } %>
            <div class="small mt-3">
              Subtotal: R$ <%= Number(order.subtotalPrice ?? 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
            </div>
            <div class="small">
              Desconto: <%= Number(order.discountPercent ?? 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>%
              (R$ <%= Number(order.discountAmount ?? 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>)
            </div>
            <div class="fs-5 fw-semibold mt-3">
              Total: R$ <%= Number(order.totalPrice ?? 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
            </div>
            <% if (order.sentAt) { %>
              <div class="small">Enviado em: <%= new Date(order.sentAt).toLocaleString('pt-BR') %></div>
            <% } %>
            <% if (order.whatsappError) { %>
              <div class="small text-danger">Erro WhatsApp: <%= order.whatsappError %></div>
            <% } %>
          </div>
        </div>
      </section>

      <section class="content-panel p-3">
        <h3 class="h6 mb-3">Itens do pedido</h3>
        <div class="table-responsive">
          <table class="table table-sm table-hover mb-0">
            <thead>
              <tr>
                <th>C&oacute;digo</th>
                <th>Produto</th>
                <th class="text-end">Unidades</th>
                <th class="text-end">Pre&ccedil;o un.</th>
                <th class="text-end">Caixas</th>
                <th class="text-end">Pre&ccedil;o cx.</th>
                <th class="text-end">Total</th>
              </tr>
            </thead>
            <tbody>
              <% order.items.forEach((item) => { %>
                <tr>
                  <td><%= item.code %></td>
                  <td>
                    <div><%= item.name %></div>
                    <% if (item.category) { %>
                      <div class="small text-muted"><%= item.category %></div>
                    <% } %>
                    <% if (!item.productId && item.manualColor) { %>
                      <div class="small text-muted">Cor: <%= item.manualColor %></div>
                    <% } %>
                  </td>
                  <td class="text-end"><%= item.productId ? `${item.unitQuantity ?? item.quantity ?? 0} UN` : `${item.unitQuantity ?? item.quantity ?? 0} ${(item.manualUnitType || 'UNIT') === 'KG' ? 'KG' : 'UN'}` %></td>
                  <td class="text-end">R$ <%= Number(item.unitPrice ?? 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></td>
                  <td class="text-end"><%= item.boxQuantity ?? 0 %></td>
                  <td class="text-end">
                    <% if (item.boxPrice) { %>
                      R$ <%= Number(item.boxPrice).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>
                    <% } else { %>
                      <span class="text-muted">-</span>
                    <% } %>
                  </td>
                  <td class="text-end fw-semibold">R$ <%= Number(item.totalPrice ?? 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></td>
                </tr>
              <% }) %>
            </tbody>
            <tfoot>
              <tr>
                <th colspan="6" class="text-end">Subtotal</th>
                <th class="text-end">R$ <%= Number(order.subtotalPrice ?? 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></th>
              </tr>
              <tr>
                <th colspan="6" class="text-end">Desconto <%= Number(order.discountPercent ?? 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %>%</th>
                <th class="text-end">R$ <%= Number(order.discountAmount ?? 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></th>
              </tr>
              <tr>
                <th colspan="6" class="text-end">Total do pedido</th>
                <th class="text-end">R$ <%= Number(order.totalPrice ?? 0).toLocaleString('pt-BR', { minimumFractionDigits: 2 }) %></th>
              </tr>
            </tfoot>
          </table>
        </div>
      </section>
    </main>
  </div>
</div>
<%- include('../partials/foot') %>
