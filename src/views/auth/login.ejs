<%- include('../partials/head') %>
<main class="login-page min-vh-100 d-flex align-items-center justify-content-center px-3">
  <section class="content-panel login-panel p-4 w-100">
    <img class="login-logo mb-3" src="/assets/images/velas-aib-logo-official.png" alt="Velas AIB">
    <h1 class="h4 mb-1">Acesso ao sistema</h1>
    <p class="text-muted mb-4">Entre para continuar</p>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/login" method="post" class="d-grid gap-3">
      <div>
        <label class="form-label" for="email">E-mail</label>
        <input class="form-control" id="email" name="email" type="email" autocomplete="username" placeholder="seuemail@aibvelas.com.br" required>
      </div>
      <div>
        <label class="form-label" for="password">Senha</label>
        <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required>
      </div>
      <button class="btn btn-primary" type="submit">Entrar</button>
    </form>
  </section>
</main>
<%- include('../partials/foot') %>
