<%- include('../partials/head') %>
<div class="app-shell d-flex">
  <%- include('../partials/sidebar') %>
  <div class="flex-grow-1">
    <%- include('../partials/topbar') %>
    <main class="p-4">
      <%- include('../partials/flash') %>
      <section class="content-panel p-3 mb-3">
        <div class="d-flex justify-content-between align-items-start gap-3">
          <div>
            <h2 class="h6 mb-1"><%= user.name %></h2>
            <div class="small text-muted"><%= user.email %> - <%= user.role %></div>
          </div>
          <a class="btn btn-sm btn-outline-secondary" href="/collaborators">Voltar</a>
        </div>
      </section>

      <section class="row g-3 mb-3">
        <div class="col-sm-6 col-xl-3">
          <div class="stat-card p-3">
            <div class="small text-muted">Pedidos hoje</div>
            <div class="fs-3 fw-semibold"><%= summary.today %></div>
          </div>
        </div>
        <div class="col-sm-6 col-xl-3">
          <div class="stat-card p-3">
            <div class="small text-muted">Pedidos na semana</div>
            <div class="fs-3 fw-semibold"><%= summary.week %></div>
          </div>
        </div>
        <div class="col-sm-6 col-xl-3">
          <div class="stat-card p-3">
            <div class="small text-muted">Últimos 15 dias</div>
            <div class="fs-3 fw-semibold"><%= summary.lastFifteenDays %></div>
          </div>
        </div>
        <div class="col-sm-6 col-xl-3">
          <div class="stat-card p-3">
            <div class="small text-muted">Pedidos no mês</div>
            <div class="fs-3 fw-semibold"><%= summary.month %></div>
          </div>
        </div>
      </section>

      <section class="content-panel p-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h3 class="h6 mb-0">Pedidos do colaborador</h3>
          <a class="btn btn-sm btn-outline-primary" href="/orders?createdById=<%= user.id %>">Ver em pedidos</a>
        </div>
        <%- include('../orders/_table', { orders }) %>
      </section>
    </main>
  </div>
</div>
<%- include('../partials/foot') %>
