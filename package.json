{
  "name": "orders-web-api",
  "version": "1.0.0",
  "description": "Versioned REST API for a web order issuance system.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "check": "node --check src/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "seed": "prisma db seed",
    "import:products": "node prisma/import-products.js",
    "catalog:sql": "node scripts/generate-catalog-sql.mjs",
    "catalog:verify": "node scripts/verify-catalog-import.mjs",
    "users:bootstrap": "node scripts/bootstrap-production-users.mjs",
    "admin:reset": "node scripts/reset-admin-password.mjs",
    "data:retention": "node scripts/enforce-data-retention.mjs"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ejs": "^6.0.1",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mariadb": "^3.4.0",
    "pdfkit": "^0.15.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^7.9.1"
  }
}
