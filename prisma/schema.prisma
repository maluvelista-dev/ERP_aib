generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(SELLER)
  active       Boolean  @default(true)
  approvalStatus ApprovalStatus @default(APPROVED)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders       Order[]
  customers    Customer[]
  auditLogs    AuditLog[]
  orderDraft   OrderDraft?

  @@map("users")
}

model Customer {
  id             String   @id @default(uuid())
  cnpj           String?
  createdById    String
  legalName      String?
  tradeName      String?
  phone          String?
  whatsapp       String?
  email          String?
  zipCode        String?
  street         String?
  number         String?
  district       String?
  city           String?
  state          String?
  active         Boolean  @default(true)
  searchKeywords Json?
  retentionUntil DateTime?
  anonymizedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders         Order[]
  createdBy      User     @relation(fields: [createdById], references: [id])

  @@unique([createdById, cnpj])
  @@index([createdById])
  @@index([createdById, active, createdAt])
  @@map("customers")
}

model Product {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  category    String
  categoryId  String?
  description String?
  unitPrice   Decimal     @default(0) @db.Decimal(10, 2)
  boxPrice    Decimal?    @db.Decimal(10, 2)
  unitsPerBox Int?
  active      Boolean     @default(true)
  sortOrder   Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  productCategory ProductCategory? @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@index([active, categoryId, sortOrder])
  @@map("products")
}

model ProductCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("product_categories")
}

model Order {
  id               String      @id @default(uuid())
  orderNumber      String      @unique
  submissionToken  String?     @unique @db.VarChar(64)
  customerId       String?
  createdById      String
  customerSnapshot Json
  sellerSnapshot   Json?
  receivedTime     String?     @db.VarChar(30)
  deliveryDays     Json?
  notes            String?     @db.Text
  fiscalEmail      String?
  contactEmail     String?
  paymentTerm      String?
  discountPercent  Decimal     @default(0) @db.Decimal(5, 2)
  discountAmount   Decimal     @default(0) @db.Decimal(10, 2)
  bonusProductSnapshot Json?
  status           OrderStatus @default(DRAFT)
  pdfUrl           String?     @db.Text
  whatsappSent     Boolean     @default(false)
  sentAt           DateTime?
  whatsappError    String?     @db.Text
  archivedAt       DateTime?
  retentionUntil   DateTime?
  anonymizedAt     DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  customer         Customer?   @relation(fields: [customerId], references: [id])
  createdBy        User        @relation(fields: [createdById], references: [id])
  items            OrderItem[]

  @@index([createdById, createdAt])
  @@index([archivedAt, retentionUntil])
  @@map("orders")
}

model WebSession {
  id        String   @id @db.VarChar(191)
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("web_sessions")
}

model OrderDraft {
  id              String   @id @default(uuid())
  createdById     String   @unique
  submissionToken String?  @db.VarChar(64)
  payload         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("order_drafts")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String   @db.VarChar(80)
  entityType String   @db.VarChar(40)
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  productId    String?
  code         String
  name         String
  category     String?
  manualUnitType String? @db.VarChar(10)
  manualColor  String?  @db.VarChar(80)
  quantity     Decimal  @db.Decimal(10, 3)
  unitQuantity Decimal  @default(0) @db.Decimal(10, 3)
  boxQuantity  Int      @default(0)
  unitPrice    Decimal  @default(0) @db.Decimal(10, 2)
  boxPrice     Decimal? @db.Decimal(10, 2)
  unitsPerBox  Int?
  totalPrice   Decimal  @default(0) @db.Decimal(10, 2)

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id])

  @@map("order_items")
}

enum Role {
  ADMIN
  SELLER
}

enum ApprovalStatus {
  PENDING
  APPROVED
}

enum OrderStatus {
  DRAFT
  PDF_GENERATED
  WHATSAPP_SENT
  WHATSAPP_ERROR
  CANCELED
}
