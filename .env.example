NODE_ENV=development
PORT=3333

# MariaDB/MySQL database running through XAMPP.
DATABASE_URL="mysql://root:@127.0.0.1:3306/orders_web"
# Use somente em processos de migração; não configure no serviço web.
MIGRATION_DATABASE_URL=
# Use somente no job controlado de retenção; não configure no serviço web.
GOVERNANCE_DATABASE_URL=

# API-owned JWT. Replace with a strong value in production.
JWT_SECRET=change-me
JWT_EXPIRES_IN=8h
SESSION_SECRET=change-me-too
BCRYPT_SALT_ROUNDS=12

# Performance and production security
DATABASE_CONNECTION_LIMIT=10
CATALOG_CACHE_TTL_MS=60000
PDF_CONCURRENCY=2
# Redis compartilhado (Railway Redis, Upstash ou equivalente). Opcional no desenvolvimento.
REDIS_URL=
DATA_RETENTION_DAYS=1825
# Comma-separated external origins allowed to call the API. Same-origin access needs no entry.
ALLOWED_ORIGINS=


# Company data printed in generated PDFs
COMPANY_NAME=COMMERCIAL COMPANY LLC
COMPANY_CNPJ=00.123.456/0001-00
COMPANY_PHONE=(11) 4004-0000
COMPANY_EMAIL=support@commercialcompany.com
